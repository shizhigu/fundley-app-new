import { useState, useCallback, useRef } from 'react'

export interface AgentOSMessage {
  role: 'user' | 'assistant' | 'tool'
  content: string
  id: string
  createdAt?: Date
  tool_name?: string
  tool_args?: any
  tool_result?: any
  status?: 'running' | 'completed' | 'failed'
  eventType?: 'content' | 'tool_call' | 'run_status'
}

export interface AgentOSEvent {
  event: string
  data: any
}

interface UseAgentOSStreamProps {
  onMessage?: (message: AgentOSMessage) => void
  onEvent?: (event: AgentOSEvent) => void
  onError?: (error: Error) => void
  onComplete?: () => void
}

export function useAgentOSStream({
  onMessage,
  onEvent,
  onError,
  onComplete,
}: UseAgentOSStreamProps = {}) {
  const [isLoading, setIsLoading] = useState(false)
  const [messages, setMessages] = useState<AgentOSMessage[]>([])
  const [currentContent, setCurrentContent] = useState('')

  // 简单的保存函数
  const saveMessage = async (chatId: string, role: 'user' | 'assistant' | 'tool', content: string, toolName?: string) => {
    try {
      console.log(`💾 Saving ${role} message:`, content.substring(0, 50))

      const body: any = { role, content }
      if (role === 'tool' && toolName) {
        body.tool_name = toolName
      }

      const response = await fetch(`/api/chats/${chatId}/messages`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      })

      if (response.ok) {
        console.log(`✅ ${role} message saved`)
      } else {
        console.error(`❌ Failed to save ${role} message`)
      }
    } catch (error) {
      console.error(`❌ Error saving ${role} message:`, error)
    }
  }

  // 防止重复执行的标志
  const processingRef = useRef<string | null>(null)

  const sendMessage = useCallback(async (
    message: string,
    chatId: string,
    teamId: string = 'financial-team'
  ) => {
    const requestId = `${message}-${Date.now()}`

    // 如果正在处理相同的消息，直接返回
    if (processingRef.current === message) {
      console.log('🚫 Duplicate message request ignored:', message)
      return
    }

    processingRef.current = message
    console.log('🎯 Processing message:', message, 'RequestID:', requestId)
    try {
      setIsLoading(true)
      setCurrentContent('')

      // 1. 立即保存用户消息
      await saveMessage(chatId, 'user', message)

      // 2. 添加用户消息到UI
      const userMessage: AgentOSMessage = {
        id: Date.now().toString(),
        role: 'user',
        content: message,
        createdAt: new Date(),
      }

      // 3. 添加AI消息占位符
      const assistantMessage: AgentOSMessage = {
        id: (Date.now() + 1).toString(),
        role: 'assistant',
        content: '',
        createdAt: new Date(),
      }

      setMessages(prev => [...prev, userMessage, assistantMessage])

      // Connect to the SSE stream
      console.log('🌐 Fetching SSE from /api/agentsos...')
      const response = await fetch('/api/agentsos', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          message,
          chatId,
          teamId,
        }),
      })

      console.log('📡 SSE Response received:', response.status, response.headers.get('content-type'))

      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`)
      }

      const reader = response.body?.getReader()
      const decoder = new TextDecoder()

      if (!reader) {
        throw new Error('No response body')
      }

      let buffer = ''
      let currentEvent = ''

      console.log('🔄 Starting SSE read loop...')
      while (true) {
        const { done, value } = await reader.read()

        if (done) {
          console.log('🔚 Stream done')
          break
        }

        // Decode the chunk
        const chunk = decoder.decode(value, { stream: true })
        buffer += chunk

        // Process complete lines
        const lines = buffer.split('\n')
        buffer = lines.pop() || '' // Keep incomplete line in buffer

        for (const line of lines) {
          if (line.trim() === '') {
            // Empty line indicates end of event
            currentEvent = ''
            continue
          }

          // Parse SSE format: "event: EventType" and "data: {json}"
          if (line.startsWith('event: ')) {
            currentEvent = line.slice(7) // Remove "event: "
            continue
          }

          if (line.startsWith('data: ')) {
            try {
              const jsonData = line.slice(6) // Remove "data: "
              if (jsonData === '[DONE]') {
                console.log('✅ Stream [DONE] received')
                onComplete?.()
                continue
              }

              const eventData = JSON.parse(jsonData)

              // Use the event from SSE header or fallback to data.event
              const eventType = currentEvent || eventData.event || 'message'

              console.log('📡 Raw SSE Event:', {
                sseEvent: currentEvent,
                dataEvent: eventData.event,
                finalEventType: eventType,
                data: eventData,
                content: eventData.content
              })

              onEvent?.({ event: eventType, data: eventData })

              // 处理核心事件
              switch (eventType) {
                case 'TeamRunContent':
                case 'content': {
                  const content = eventData.content || eventData.data?.content || ''
                  if (content) {
                    setMessages(prev => prev.map(msg =>
                      msg.id === assistantMessage.id
                        ? { ...msg, content: msg.content + content }
                        : msg
                    ))
                  }
                  break
                }

                case 'TeamToolCallStarted': {
                  const toolData = eventData.tool || eventData.data?.tool
                  console.log('🔧 Tool started:', toolData?.tool_name)

                  const toolMessage: AgentOSMessage = {
                    id: `tool_${toolData?.tool_call_id || Date.now()}`,
                    role: 'tool',
                    content: `🔧 调用 ${toolData?.tool_name || 'tool'}...`,
                    tool_name: toolData?.tool_name,
                    status: 'running',
                    createdAt: new Date(),
                  }

                  setMessages(prev => [...prev, toolMessage])
                  break
                }

                case 'TeamToolCallCompleted': {
                  const toolData = eventData.tool || eventData.data?.tool
                  console.log('✅ Tool completed:', toolData?.tool_name)

                  const toolCallId = `tool_${toolData?.tool_call_id || 'unknown'}`
                  setMessages(prev => prev.map(msg =>
                    msg.id === toolCallId ? {
                      ...msg,
                      content: `✅ ${toolData?.tool_name || 'Tool'} 完成`,
                      tool_result: toolData?.result,
                      status: 'completed' as const,
                    } : msg
                  ))
                  break
                }

                default:
                  // 忽略其他事件
                  break
              }
            } catch (err) {
              console.warn('Failed to parse SSE data:', line, err)
            }
          }
        }
      }

      // Stream完成，直接保存所有新消息
      console.log('🎯 Stream complete, auto-saving all new messages')

      // 保存这次对话中的assistant消息（最后一个）
      setMessages(prev => {
        const lastAssistant = [...prev].reverse().find(msg => msg.role === 'assistant' && msg.content.trim())
        if (lastAssistant) {
          console.log('💾 Auto-saving assistant:', lastAssistant.content.substring(0, 50))
          saveMessage(chatId, 'assistant', lastAssistant.content)
        }

        // 保存所有tool消息
        const newToolMsgs = prev.filter(msg => msg.role === 'tool' && msg.content)
        newToolMsgs.forEach(toolMsg => {
          console.log('💾 Auto-saving tool:', toolMsg.tool_name)
          saveMessage(chatId, 'tool', toolMsg.content, toolMsg.tool_name)
        })

        return prev
      })

      onComplete?.()

    } catch (error) {
      console.error('Error in AgentOS stream:', error)
      onError?.(error instanceof Error ? error : new Error('Unknown error'))
    } finally {
      setIsLoading(false)
      processingRef.current = null // 清除处理标志
    }
  }, [currentContent, onMessage, onEvent, onError, onComplete])

  const clearMessages = useCallback(() => {
    setMessages([])
    setCurrentContent('')
  }, [])

  return {
    messages,
    isLoading,
    sendMessage,
    clearMessages,
    currentContent,
  }
}